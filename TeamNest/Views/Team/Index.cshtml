@model TeamViewModel
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Team";
    var isOwner = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.OwnerOnly)).Succeeded;
}

<div class="page-header">
    <div>
        <h1>Team</h1>
        <p class="text-soft mb-0">@Model.Members.Count() @(Model.Members.Count() == 1 ? "person" : "people") in @Model.OrganizationName.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <section class="panel p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Role</th>
                            <th scope="col">Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar avatar-lg">@member.Initials</span>
                                        <div class="lh-sm">
                                            <div class="fw-semibold">@member.FullName</div>
                                            <div class="text-soft small">@member.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="role role-@(member.Role?.ToLowerInvariant() ?? "member")">@(member.Role ?? AppRoles.Member)</span></td>
                                <td class="text-soft text-nowrap">@member.JoinedAt.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-xl-4">
        <section class="panel">
            <h2>Invite code</h2>
            <p class="text-soft small">Share this code with people you want in this workspace. They join as Members.</p>
            <div class="invite-box">
                <code class="invite-code" id="teamInviteCode">@Model.InviteCode</code>
                <button type="button" class="btn btn-quiet btn-sm" data-copy-target="#teamInviteCode">
                    <i class="bi bi-clipboard"></i> Copy
                </button>
            </div>

            @if (isOwner)
            {
                <hr class="my-4" />
                <p class="small text-soft mb-2">If the code was shared with the wrong person, create a new one. The old code stops working right away.</p>
                <button type="button" class="btn btn-quiet btn-sm" id="regenerateCode"
                        data-url="@Url.Action("RegenerateInviteCode", "Team")">
                    <i class="bi bi-arrow-repeat"></i> Create new code
                </button>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // AJAX: create a new invite code without reloading the page (Owner only)
        document.getElementById('regenerateCode')?.addEventListener('click', async (event) => {
            const button = event.currentTarget;
            if (!confirm('Create a new invite code? The current code will stop working.')) return;

            button.disabled = true;
            try {
                const data = await TeamNest.post(button.dataset.url);
                document.getElementById('teamInviteCode').textContent = data.code;
                TeamNest.toast(data.message);
            } catch (error) {
                TeamNest.toast(error.message, 'error');
            } finally {
                button.disabled = false;
            }
        });
    </script>
}
