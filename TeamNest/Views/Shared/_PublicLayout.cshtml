@* PUBLIC LAYOUT: navbar + footer for the landing page. Nested inside _Layout. *@
@{
    Layout = "_Layout";
}

<nav class="navbar navbar-expand-lg site-nav py-3">
    <div class="container">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark"><i class="bi bi-kanban"></i></span>
            TeamNest
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Open menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="features">Features</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How it works</a></li>
                <partial name="_LoginPartial" />
            </ul>
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <span>&copy; @DateTime.Now.Year TeamNest</span>
        <span>Built with ASP.NET Core MVC</span>
    </div>
</footer>

@* A nested layout must pass the child page's Scripts section up to _Layout *@
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
