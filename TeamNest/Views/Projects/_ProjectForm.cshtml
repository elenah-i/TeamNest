@* The "New project" form inside the modal. Returned again by the server with errors if validation fails. *@
@model ProjectFormViewModel

<form asp-action="Create" method="post" id="projectForm">
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
        <partial name="_ProjectFields" model="Model" />
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-nest">Create project</button>
    </div>
</form>
