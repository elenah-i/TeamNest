@model ProjectFormViewModel
@{
    ViewData["Title"] = "Edit project";
}

<div class="page-header">
    <div>
        <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Projects</a>
        <h1>Edit project</h1>
    </div>
</div>

<section class="panel form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <partial name="_ProjectFields" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-nest">Save changes</button>
            <a class="btn btn-quiet" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
